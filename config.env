# shellcheck shell=bash
# shellcheck disable=SC2034  # variables are consumed by the scripts that source this file
#
# The single place where versions, checksums and URLs live.
# Sourced by every script, on the host and inside the build containers.
# Machine-local overrides (never versions or checksums) may go into an
# untracked config.local.env next to this file.

# --- Target platform ---------------------------------------------------------
EL_RELEASE=9.7
ARCH=x86_64
# Space-separated list of full kernel releases (without .arch); one build each.
KVERS="5.14.0-611.55.1.el9_7"

# --- Build and test containers -----------------------------------------------
# Rocky 9.7 GA image, pinned by digest (created 2025-11-23).
BASE_IMAGE="docker.io/rockylinux/rockylinux:9.7@sha256:53f4c6dcb34e1403bd93207351f0af9a593610faeb7165cb8a037346765199b0"
# Root of the frozen 9.7 trees. BaseOS, AppStream, CRB and the BaseOS debug
# tree are derived from it. The Rocky vault keeps retired minor releases
# forever; a local mirror with the same layout works too, e.g.
# http://lxrpt8.gsi.de/rocky/9.7
ROCKY_BASEURL="https://dl.rockylinux.org/vault/rocky/9.7"
ROCKY_GPGKEY="file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9"

# --- DRBD kernel module ------------------------------------------------------
DRBD_VERSION=9.3.4
DRBD_URL="https://pkg.linbit.com/downloads/drbd/9/drbd-${DRBD_VERSION}.tar.gz"
# LINBIT publishes no checksums; recorded on first download after comparing
# the tarball with the drbd-9.3.4 git tag.
DRBD_SHA256=a2de4b7ffc43fdabad01b0bf7283b910eb6401b0f788e33a65ae94fc0588545c
# yes: allow LINBIT's spatch-as-a-service (https://spaas.drbd.io) when neither
# the tarball nor patches/drbd-compat/ has a compat patch for a kernel.
DRBD_ALLOW_SPAAS=no

# --- drbd-utils --------------------------------------------------------------
DRBD_UTILS_VERSION=9.35.0
DRBD_UTILS_URL="https://pkg.linbit.com/downloads/drbd/utils/drbd-utils-${DRBD_UTILS_VERSION}.tar.gz"
DRBD_UTILS_SHA256=8815afb25c84fafadf6ef43be68805d261c5f33ec29016121a327821acaf6ade

# --- Lustre server -----------------------------------------------------------
LUSTRE_VERSION=2.17.0
LUSTRE_SRPM_URL="https://downloads.whamcloud.com/public/lustre/lustre-${LUSTRE_VERSION}/el9.7/server/SRPMS/lustre-${LUSTRE_VERSION}-1.src.rpm"
# From Whamcloud's SRPMS/sha256sum.
LUSTRE_SRPM_SHA256=5faa4e1523aaa97b7855d61e2031b9bf8bd5c51fffac6726098906142067a525
LUSTRE_WITH_IOKIT=yes
LUSTRE_WITH_TESTS=no

# --- Whamcloud e2fsprogs (mirrored unchanged into a separate repo) -----------
E2FSPROGS_BASEURL="https://downloads.whamcloud.com/public/e2fsprogs/1.47.3.wc2/el9/RPMS/x86_64"
# "sha256  file" lines, copied from Whamcloud's sha256sum in that directory.
E2FSPROGS_FILES="
d5ed33fe57677717fc1e13402666e5290a3a2da7613e393424049afa379bfc65  e2fsprogs-1.47.3-wc2.el9.x86_64.rpm
484f993a2e4dbcbf7e6655852a5f651307d8b4b70ca684a758ab88aa5ad4cb69  e2fsprogs-devel-1.47.3-wc2.el9.x86_64.rpm
7432eb2e851d22f3efe10c2808266369ff78410cc50c54c30e7ea3915768e48b  e2fsprogs-libs-1.47.3-wc2.el9.x86_64.rpm
dbec0fe09880e6d17c5252ad42ff13ba6f165304aab741a494abf77c06bd8e02  libcom_err-1.47.3-wc2.el9.x86_64.rpm
56ee17e487ccff1a4cf7a61b69c4d669ff52d4fb2decb15f2195ff72342c2674  libcom_err-devel-1.47.3-wc2.el9.x86_64.rpm
409d3634e059805da9ad4b8b8d7fa0add896ab58817698bf51dd106c6176fbfe  libss-1.47.3-wc2.el9.x86_64.rpm
267bdf8286f8772856d0947171366346f249bda3dbcc5b72fe4b75fb85032805  libss-devel-1.47.3-wc2.el9.x86_64.rpm
"

# --- Output repository -------------------------------------------------------
# Appended to the Release of everything we build. Bump it (gsi2, ...) to
# publish a rebuild of the same upstream version: published files are never
# replaced.
SITE_RELEASE_SUFFIX=gsi1
REPO_ID=gsi-kmods
REPO_NAME="GSI prebuilt kernel modules"
# Only used to render the .repo file; the tree itself is location independent.
REPO_PUBLIC_BASEURL="http://repo.example.gsi.de/gsi-kmods"
OUT_DIR=out/repo
# yes: also publish *-debuginfo / *-debugsource packages.
PUBLISH_DEBUGINFO=no
# Empty: unsigned dev mode. Otherwise the key used for rpmsign and repomd.xml.asc.
GPG_KEY_ID=
