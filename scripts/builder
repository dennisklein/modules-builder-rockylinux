#!/bin/bash
# Host-side entry point. Every step runs in a throwaway container; the host
# only needs bash, make and podman (or docker).
#
#   builder image                 build the builder image if it is missing
#   builder fetch                 download and verify all configured sources
#   builder build COMPONENT       build drbd or lustre for every kernel in KVERS,
#                                 or drbd-utils (once)
#   builder repo                  publish build results into OUT_DIR, sign, index
#   builder verify                check every kmod in OUT_DIR
#   builder test [file|http]      install test in fresh containers, one per kernel
#   builder keygen                create a new signing key in KEYDIR
#   builder shell [IMAGE]         interactive shell in the builder image
#
# Machine-local knobs (environment, not config):
#   CONTAINER_RUNTIME     podman or docker (default: podman if installed)
#   BUILDER_NETWORK       network mode for all containers (e.g. host)
#   BUILDER_CA_BUNDLE     extra CA bundle to trust inside the containers
#   http(s)_proxy, no_proxy are passed through when set.
# Signing (only when GPG_KEY_ID is set in the config):
#   GPG_PRIVATE_KEY_FILE  armored secret key (e.g. a CI secret file), or
#   GNUPGHOME             GnuPG home holding the key (default ~/.gnupg)
#   GPG_PASSPHRASE_FILE   passphrase, if the key has one
#   KEYDIR, KEY_UID       for "builder keygen"
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=lib.sh
. "$ROOT/scripts/lib.sh"
load_config "$ROOT"

[[ $OUT_DIR == /* ]] || OUT_DIR=$ROOT/$OUT_DIR
PROXY_VARS=(http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY)
EXTRA=()   # additional arguments for the next run_step

detect_runtime() {
	RT=${CONTAINER_RUNTIME:-}
	if [[ -z $RT ]]; then
		if command -v podman >/dev/null; then RT=podman
		elif command -v docker >/dev/null; then RT=docker
		else die "neither podman nor docker found"; fi
	fi
	command -v "$RT" >/dev/null || die "container runtime not found: $RT"

	# Files written by root in the container belong to root on the host,
	# except with rootless podman, where container root is the calling user.
	OWNER=
	if [[ $(id -u) != 0 ]]; then
		if [[ $RT != podman ]] ||
			[[ $("$RT" info --format '{{.Host.Security.Rootless}}' 2>/dev/null) != true ]]; then
			OWNER=$(id -u):$(id -g)
		fi
	fi
}

# The image tag changes whenever anything that goes into the image changes.
image_tag() {
	local h
	h=$({
		cat "$ROOT/Containerfile" "$ROOT/scripts/in-container/render-rocky-repos.sh"
		printf '%s\n' "$BASE_IMAGE" "$ROCKY_BASEURL" "$ROCKY_GPGKEY"
	} | sha256sum | cut -c1-12)
	printf 'localhost/kmod-builder:%s-%s\n' "$EL_TAG" "$h"
}

cmd_image() {
	IMAGE=$(image_tag)
	if "$RT" image inspect "$IMAGE" >/dev/null 2>&1; then
		return 0
	fi
	log "building image $IMAGE"
	local args=(build -t "$IMAGE" -f "$ROOT/Containerfile"
		--build-arg "BASE_IMAGE=$BASE_IMAGE"
		--build-arg "ROCKY_BASEURL=$ROCKY_BASEURL"
		--build-arg "ROCKY_GPGKEY=$ROCKY_GPGKEY")
	local v
	for v in "${PROXY_VARS[@]}"; do
		if [[ -n ${!v:-} ]]; then args+=(--build-arg "$v=${!v}"); fi
	done
	if [[ -n ${BUILDER_CA_BUNDLE:-} ]]; then args+=(--secret "id=ca,src=$BUILDER_CA_BUNDLE"); fi
	if [[ -n ${BUILDER_NETWORK:-} ]]; then args+=(--network "$BUILDER_NETWORK"); fi
	"$RT" "${args[@]}" "$ROOT/scripts/in-container"
}

# run_step IMAGE STEP [ARGS...]: run scripts/in-container/STEP.sh in a fresh
# container. The project is mounted read-only; sources/, build/ and OUT_DIR
# are writable.
run_step() {
	local image=$1; shift
	mkdir -p "$ROOT/sources" "$ROOT/build" "$OUT_DIR"
	local args=(run --rm --security-opt label=disable
		-v "$ROOT:/src:ro"
		-v "$ROOT/sources:/sources"
		-v "$ROOT/build:/build"
		-v "$OUT_DIR:/repo"
		-v "kmod-builder-dnf-cache-$EL_TAG:/var/cache/dnf"
		-e FORCE -e KEEP -e "OWNER=$OWNER")
	local v
	for v in "${PROXY_VARS[@]}"; do
		if [[ -n ${!v:-} ]]; then args+=(-e "$v"); fi
	done
	if [[ -n ${BUILDER_CA_BUNDLE:-} ]]; then
		args+=(-v "$(realpath "$BUILDER_CA_BUNDLE"):/run/builder-ca.crt:ro")
	fi
	if [[ -n ${BUILDER_NETWORK:-} ]]; then args+=(--network "$BUILDER_NETWORK"); fi
	if [[ -t 0 && -t 1 ]]; then args+=(-t); fi
	args+=("${EXTRA[@]}")
	EXTRA=()
	"$RT" "${args[@]}" "$image" /src/scripts/in-container/entry.sh "$@"
}

# Hand the signing key to the repo step (read-only; copied inside).
signing_mounts() {
	[[ -n $GPG_KEY_ID ]] || return 0
	if [[ -n ${GPG_PRIVATE_KEY_FILE:-} ]]; then
		[[ -r $GPG_PRIVATE_KEY_FILE ]] || die "GPG_PRIVATE_KEY_FILE not readable: $GPG_PRIVATE_KEY_FILE"
		EXTRA+=(-v "$(realpath "$GPG_PRIVATE_KEY_FILE"):/run/gpg-key.asc:ro")
	else
		local home=${GNUPGHOME:-$HOME/.gnupg}
		[[ -d $home ]] || die "GPG_KEY_ID is set but neither GPG_PRIVATE_KEY_FILE nor GNUPGHOME ($home) is available"
		EXTRA+=(-v "$(realpath "$home"):/run/gnupg-home:ro")
	fi
	passphrase_mount
}

passphrase_mount() {
	if [[ -n ${GPG_PASSPHRASE_FILE:-} ]]; then
		[[ -r $GPG_PASSPHRASE_FILE ]] || die "GPG_PASSPHRASE_FILE not readable: $GPG_PASSPHRASE_FILE"
		EXTRA+=(-v "$(realpath "$GPG_PASSPHRASE_FILE"):/run/gpg-passphrase:ro")
	fi
}

# Compat patches generated during a build (SPAAS or local spatch) are handed
# back in build/drbd-compat/; keep them in the source tree so the next build
# of that kernel is offline and deterministic.
import_drbd_compat() {
	local d md5
	for d in "$ROOT"/build/drbd-compat/*/; do
		[[ -d $d ]] || continue
		md5=$(basename "$d")
		if [[ ! -d $ROOT/patches/drbd-compat/$md5 ]]; then
			mkdir -p "$ROOT/patches/drbd-compat/$md5"
			cp "$d"/* "$ROOT/patches/drbd-compat/$md5/"
			log "new DRBD compat patch saved: patches/drbd-compat/$md5 -- commit it"
		fi
	done
	return 0
}

cmd_build() {
	local component=${1:?usage: builder build COMPONENT}
	cmd_image
	case $component in
	drbd | lustre)
		local kver
		for kver in $KVERS; do
			log "building $component for $kver"
			run_step "$IMAGE" "build-$component" "$kver"
		done
		if [[ $component == drbd ]]; then import_drbd_compat; fi
		;;
	drbd-utils)
		log "building drbd-utils"
		run_step "$IMAGE" build-drbd-utils
		;;
	*) die "unknown component: $component" ;;
	esac
}

cmd_test() {
	local transport=${1:-file} kver
	for kver in $KVERS; do
		log "install test for $kver ($transport) in a fresh $BASE_IMAGE container"
		run_step "$BASE_IMAGE" test-install "$kver" "$transport"
	done
}

cmd_keygen() {
	[[ -n ${KEYDIR:-} ]] || die "set KEYDIR to a directory outside this repository"
	mkdir -p "$KEYDIR"
	local keydir
	keydir=$(realpath "$KEYDIR")
	[[ $keydir != "$ROOT" && $keydir != "$ROOT"/* ]] ||
		die "KEYDIR must not be inside the repository: $keydir"
	cmd_image
	EXTRA+=(-v "$keydir:/keys" -e KEY_UID)
	passphrase_mount
	run_step "$IMAGE" keygen
}

cmd_shell() {
	cmd_image
	local image=${1:-$IMAGE}
	local args=(run --rm -it --security-opt label=disable
		-v "$ROOT:/src:ro" -v "$ROOT/sources:/sources" -v "$ROOT/build:/build"
		-v "$OUT_DIR:/repo" -v "kmod-builder-dnf-cache-$EL_TAG:/var/cache/dnf")
	if [[ -n ${BUILDER_NETWORK:-} ]]; then args+=(--network "$BUILDER_NETWORK"); fi
	"$RT" "${args[@]}" "$image" bash
}

detect_runtime
cmd=${1:-}
[[ -n $cmd ]] && shift
case $cmd in
image) cmd_image ;;
fetch) cmd_image; run_step "$IMAGE" fetch ;;
build) cmd_build "$@" ;;
repo) cmd_image; signing_mounts; run_step "$IMAGE" make-repo ;;
verify) cmd_image; run_step "$IMAGE" verify ;;
test) cmd_test "$@" ;;
keygen) cmd_keygen ;;
shell) cmd_shell "$@" ;;
*) sed -n '2,/^set -euo/{/^#/s/^# \{0,1\}//p}' "$0"; exit 2 ;;
esac
